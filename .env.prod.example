# Copy this to .env.prod and fill in real values — never reuse dev placeholder values here.
# Used by:
#   docker compose --env-file .env.prod up -d --build
#
# docker-compose.yml deploys only the crawler — Postgres and Redis already exist elsewhere
# (e.g. Dokploy Database resources). Point these at your real instances.

# The shared quotes Postgres database. The crawler owns its schema (quotes, url_frontier) and
# self-migrates on startup. Every consumer of the corpus (e.g. Vroomy's api/ws) reads this same
# database via its own DATABASE_URL — that connection string is the only coupling between them.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# The crawler's own Redis (frontier queues + simhash LSH cache). Nothing else uses it, and it's
# fully rebuildable from Postgres on every start. redis://... form is fine directly.
REDIS_ADDR=redis://default:PASSWORD@HOST:6379
